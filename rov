#!/usr/bin/env bash
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if command -v python3 >/dev/null 2>&1; then
    exec python3 "${SCRIPT_DIR}/tools/rov.py" "$@"
elif command -v python >/dev/null 2>&1; then
    exec python "${SCRIPT_DIR}/tools/rov.py" "$@"
else
    echo "Error: python3 or python must be installed and on PATH." >&2
    exit 1
fi
