  DEP_FILE = services/CMakeFiles/rov_services.dir/src/actuator_service.c.obj.d
  FLAGS = -mcpu=cortex-m4 -mfpu=fpv4-sp-d16 -mfloat-abi=hard  -Wall -fdata-sections -ffunction-sections -fstack-usage -O0 -g3 -std=gnu11
  INCLUDES = -I/app/services/include -I/app/services/../shared/include -I/app/services/../drivers/include -I/app/shared/include -I/app/drivers/include -I/app/drivers/../shared/include
  OBJECT_DIR = services/CMakeFiles/rov_services.dir
  OBJECT_FILE_DIR = services/CMakeFiles/rov_services.dir/src

build services/CMakeFiles/rov_services.dir/src/power_service.c.obj: C_COMPILER__rov_services_unscanned_Debug /app/services/src/power_service.c || cmake_object_order_depends_target_rov_services
  DEP_FILE = services/CMakeFiles/rov_services.dir/src/power_service.c.obj.d
  FLAGS = -mcpu=cortex-m4 -mfpu=fpv4-sp-d16 -mfloat-abi=hard  -Wall -fdata-sections -ffunction-sections -fstack-usage -O0 -g3 -std=gnu11
  INCLUDES = -I/app/services/include -I/app/services/../shared/include -I/app/services/../drivers/include -I/app/shared/include -I/app/drivers/include -I/app/drivers/../shared/include
  OBJECT_DIR = services/CMakeFiles/rov_services.dir
  OBJECT_FILE_DIR = services/CMakeFiles/rov_services.dir/src


# =============================================================================
# Link build statements for STATIC_LIBRARY target rov_services


#############################################
# Link the static library services/librov_services.a

build services/librov_services.a: C_STATIC_LIBRARY_LINKER__rov_services_Debug services/CMakeFiles/rov_services.dir/src/env_service.c.obj services/CMakeFiles/rov_services.dir/src/safety_service.c.obj services/CMakeFiles/rov_services.dir/src/actuator_service.c.obj services/CMakeFiles/rov_services.dir/src/power_service.c.obj || drivers/librov_drivers.a shared/librov_shared.a
  LANGUAGE_COMPILE_FLAGS = -mcpu=cortex-m4 -mfpu=fpv4-sp-d16 -mfloat-abi=hard  -Wall -fdata-sections -ffunction-sections -fstack-usage -O0 -g3
  OBJECT_DIR = services/CMakeFiles/rov_services.dir
  POST_BUILD = :
  PRE_LINK = :
  TARGET_FILE = services/librov_services.a
  TARGET_PDB = rov_services.a.dbg


#############################################
# Utility command for edit_cache

build services/CMakeFiles/edit_cache.util: CUSTOM_COMMAND
  COMMAND = cd /app/build-node2/services && /usr/bin/cmake -E echo No\ interactive\ CMake\ dialog\ available.
  DESC = No interactive CMake dialog available...
  restat = 1

build services/edit_cache: phony services/CMakeFiles/edit_cache.util


#############################################
# Utility command for rebuild_cache

build services/CMakeFiles/rebuild_cache.util: CUSTOM_COMMAND
  COMMAND = cd /app/build-node2/services && /usr/bin/cmake --regenerate-during-build -S/app/nodes/node2_control_board -B/app/build-node2
  DESC = Running CMake to regenerate build system...
  pool = console
  restat = 1

build services/rebuild_cache: phony services/CMakeFiles/rebuild_cache.util

# =============================================================================
# Target aliases.

build STM32_Drivers: phony cmake/stm32cubemx/STM32_Drivers

build librov_drivers.a: phony drivers/librov_drivers.a

build librov_services.a: phony services/librov_services.a

build librov_shared.a: phony shared/librov_shared.a

build node2_control_board: phony node2_control_board.elf

build node2_i2c_scanner: phony node2_i2c_scanner.elf

build rov_drivers: phony drivers/librov_drivers.a

build rov_services: phony services/librov_services.a

build rov_shared: phony shared/librov_shared.a

build sandbox: phony sandbox.elf

# =============================================================================
# Folder targets.

# =============================================================================

#############################################
# Folder: /app/build-node2

build all: phony node2_control_board.elf node2_i2c_scanner.elf sandbox.elf cmake/stm32cubemx/all shared/all drivers/all services/all

# =============================================================================

#############################################
# Folder: /app/build-node2/cmake/stm32cubemx

build cmake/stm32cubemx/all: phony cmake/stm32cubemx/STM32_Drivers

# =============================================================================

#############################################
# Folder: /app/build-node2/drivers

build drivers/all: phony drivers/librov_drivers.a

# =============================================================================

#############################################
# Folder: /app/build-node2/services

build services/all: phony services/librov_services.a

# =============================================================================

#############################################
# Folder: /app/build-node2/shared

build shared/all: phony shared/librov_shared.a

# =============================================================================
# Built-in targets


#############################################
# Re-run CMake if any of its inputs changed.

build build.ninja: RERUN_CMAKE | /app/drivers/CMakeLists.txt /app/nodes/node2_control_board/CMakeLists.txt /app/nodes/node2_control_board/cmake/gcc-arm-none-eabi.cmake /app/nodes/node2_control_board/cmake/stm32cubemx/CMakeLists.txt /app/services/CMakeLists.txt /app/shared/CMakeLists.txt /usr/share/cmake-3.28/Modules/CMakeASMInformation.cmake /usr/share/cmake-3.28/Modules/CMakeCInformation.cmake /usr/share/cmake-3.28/Modules/CMakeCommonLanguageInclude.cmake /usr/share/cmake-3.28/Modules/CMakeGenericSystem.cmake /usr/share/cmake-3.28/Modules/CMakeInitializeConfigs.cmake /usr/share/cmake-3.28/Modules/CMakeLanguageInformation.cmake /usr/share/cmake-3.28/Modules/CMakeSystemSpecificInformation.cmake /usr/share/cmake-3.28/Modules/CMakeSystemSpecificInitialize.cmake /usr/share/cmake-3.28/Modules/Compiler/CMakeCommonCompilerMacros.cmake /usr/share/cmake-3.28/Modules/Compiler/GNU-ASM.cmake /usr/share/cmake-3.28/Modules/Compiler/GNU-C.cmake /usr/share/cmake-3.28/Modules/Compiler/GNU.cmake /usr/share/cmake-3.28/Modules/Platform/Generic.cmake CMakeCache.txt CMakeFiles/3.28.3/CMakeASMCompiler.cmake CMakeFiles/3.28.3/CMakeCCompiler.cmake CMakeFiles/3.28.3/CMakeSystem.cmake
  pool = console


#############################################
# A missing CMake input file is not an error.

build /app/drivers/CMakeLists.txt /app/nodes/node2_control_board/CMakeLists.txt /app/nodes/node2_control_board/cmake/gcc-arm-none-eabi.cmake /app/nodes/node2_control_board/cmake/stm32cubemx/CMakeLists.txt /app/services/CMakeLists.txt /app/shared/CMakeLists.txt /usr/share/cmake-3.28/Modules/CMakeASMInformation.cmake /usr/share/cmake-3.28/Modules/CMakeCInformation.cmake /usr/share/cmake-3.28/Modules/CMakeCommonLanguageInclude.cmake /usr/share/cmake-3.28/Modules/CMakeGenericSystem.cmake /usr/share/cmake-3.28/Modules/CMakeInitializeConfigs.cmake /usr/share/cmake-3.28/Modules/CMakeLanguageInformation.cmake /usr/share/cmake-3.28/Modules/CMakeSystemSpecificInformation.cmake /usr/share/cmake-3.28/Modules/CMakeSystemSpecificInitialize.cmake /usr/share/cmake-3.28/Modules/Compiler/CMakeCommonCompilerMacros.cmake /usr/share/cmake-3.28/Modules/Compiler/GNU-ASM.cmake /usr/share/cmake-3.28/Modules/Compiler/GNU-C.cmake /usr/share/cmake-3.28/Modules/Compiler/GNU.cmake /usr/share/cmake-3.28/Modules/Platform/Generic.cmake CMakeCache.txt CMakeFiles/3.28.3/CMakeASMCompiler.cmake CMakeFiles/3.28.3/CMakeCCompiler.cmake CMakeFiles/3.28.3/CMakeSystem.cmake: phony


#############################################
# Clean additional files.

build CMakeFiles/clean.additional: CLEAN_ADDITIONAL
  CONFIG = Debug


#############################################
# Clean all the built files.

build clean: CLEAN CMakeFiles/clean.additional


#############################################
# Print all primary targets available.

build help: HELP


#############################################
# Make the all target the default.

default all
