{
    "folders": [
        {
            "name": "X19-Embedded (Root)",
            "path": "."
        },
        {
            "name": "Shared Library",
            "path": "shared"
        },
        {
            "name": "Hardware Drivers",
            "path": "drivers"
        },
        {
            "name": "Node 1: Pi Shield",
            "path": "nodes/node1_pi_shield"
        },
        {
            "name": "Node 2: Control Board",
            "path": "nodes/node2_control_board"
        },
        {
            "name": "Node 3: Power Slab",
            "path": "nodes/node3_power_slab"
        },
        {
            "name": "Node 4: USB Camera Hub",
            "path": "nodes/node4_usb_hub"
        },
        {
            "name": "CAN Bootloader Suite",
            "path": "bootloader"
        },
        {
            "name": "Testing & R&D Project",
            "path": "nodes/testing_and_rnd"
        }
    ],
    "settings": {
        "cmake.useCMakePresets": "always",
        "cmake.sourceDirectory": "${workspaceFolder}",
        "cmake.configureOnOpen": false,
        "C_Cpp.default.cStandard": "c11",
        "C_Cpp.default.cppStandard": "c++17",
        "C_Cpp.default.intelliSenseMode": "gcc-arm",
        "C_Cpp.default.includePath": [
            "${workspaceFolder}/shared/include",
            "${workspaceFolder}/drivers/include",
            "${workspaceFolder}/**"
        ],
        "files.associations": {
            "*.h": "c",
            "*.c": "c",
            "*.ioc": "xml"
        },
        "files.exclude": {
            "**/.git": true,
            "**/.DS_Store": true
        },
        "cortex-debug.armToolchainPath.windows": "C:/ST/STM32CubeCLT_1.22.0/GNU-tools-for-STM32/bin",
        "cortex-debug.stlinkPath.windows": "C:/ST/STM32CubeCLT_1.22.0/STLink-gdb-server/bin/ST-LINK_gdbserver.exe",
        "cortex-debug.stm32cubeprogrammer": "C:/ST/STM32CubeCLT_1.22.0/STM32CubeProgrammer/bin",
        "cortex-debug.stm32cubeprogrammer.windows": "C:/ST/STM32CubeCLT_1.22.0/STM32CubeProgrammer/bin",
        "cortex-debug.armToolchainPath.linux": "/opt/st/stm32cubeclt/GNU-tools-for-STM32/bin",
        "cortex-debug.stlinkPath.linux": "/opt/st/stm32cubeclt/STLink-gdb-server/bin/ST-LINK_gdbserver",
        "cortex-debug.stm32cubeprogrammer.linux": "/opt/st/stm32cubeclt/STM32CubeProgrammer/bin",
        "cortex-debug.armToolchainPath.osx": "/Applications/ArmGNUToolchain/bin",
        "cortex-debug.stm32cubeprogrammer.osx": "/Applications/STM32CubeProgrammer.app/Contents/MacOs/bin"
    },
    "extensions": {
        "recommendations": [
            "marus25.cortex-debug",
            "ms-vscode.cpptools",
            "ms-vscode.cmake-tools",
            "twxs.cmake"
        ]
    }
}