{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug: Control Board (STM32G4)",
            "type": "cortex-debug",
            "request": "launch",
            "servertype": "openocd",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/build/nodes/node2_control_board/node2_control_board.elf",
            "device": "STM32G431CB",
            "configFiles": [
                "interface/stlink.cfg",
                "target/stm32g4x.cfg"
            ],
            "runToEntryPoint": "main",
            "svdFile": "${workspaceFolder}/cmake/STM32G431xx.svd"
        },
        {
            "name": "Debug: Power Slab (STM32G4)",
            "type": "cortex-debug",
            "request": "launch",
            "servertype": "openocd",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/build/nodes/node3_power_slab/node3_power_slab.elf",
            "device": "STM32G431K8",
            "configFiles": [
                "interface/stlink.cfg",
                "target/stm32g4x.cfg"
            ],
            "runToEntryPoint": "main"
        },
        {
            "name": "Debug: Pi Shield (STM32G4)",
            "type": "cortex-debug",
            "request": "launch",
            "servertype": "openocd",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/build/nodes/node1_pi_shield/node1_pi_shield.elf",
            "device": "STM32G431K8",
            "configFiles": [
                "interface/stlink.cfg",
                "target/stm32g4x.cfg"
            ],
            "runToEntryPoint": "main"
        },
        {
            "name": "Debug: CAN Bootloader (STM32G4)",
            "type": "cortex-debug",
            "request": "launch",
            "servertype": "openocd",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/build/bootloader/stm32_can_bootloader/stm32_can_bootloader.elf",
            "device": "STM32G431xx",
            "configFiles": [
                "interface/stlink.cfg",
                "target/stm32g4x.cfg"
            ],
            "runToEntryPoint": "main"
        }
    ]
}
