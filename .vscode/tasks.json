{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Configure: Host SIL (Debug)",
      "type": "process",
      "command": "cmake",
      "args": ["--preset", "sil-debug"],
      "problemMatcher": []
    },
    {
      "label": "Build: Host SIL (Debug)",
      "type": "process",
      "command": "cmake",
      "args": ["--build", "--preset", "sil-debug"],
      "dependsOn": "Configure: Host SIL (Debug)",
      "dependsOrder": "sequence",
      "group": {"kind": "build", "isDefault": true},
      "problemMatcher": "$gcc"
    },
    {
      "label": "Test: Host SIL (Debug)",
      "type": "process",
      "command": "ctest",
      "args": ["--preset", "sil-debug"],
      "dependsOn": "Build: Host SIL (Debug)",
      "dependsOrder": "sequence",
      "problemMatcher": "$gcc"
    },
    {
      "label": "Configure: Node 2 Nucleo G474 (Debug)",
      "type": "process",
      "command": "cmake",
      "args": ["--preset", "Debug"],
      "options": {"cwd": "${workspaceFolder}/nodes/node2_control_board"},
      "problemMatcher": []
    },
    {
      "label": "Build: Node 2 Nucleo G474 (Debug)",
      "type": "process",
      "command": "cmake",
      "args": ["--build", "--preset", "Debug"],
      "options": {"cwd": "${workspaceFolder}/nodes/node2_control_board"},
      "dependsOn": "Configure: Node 2 Nucleo G474 (Debug)",
      "dependsOrder": "sequence",
      "problemMatcher": "$gcc"
    },
    {
      "label": "Clean: Host SIL (Debug)",
      "type": "process",
      "command": "cmake",
      "args": ["--build", "--preset", "sil-debug", "--target", "clean"],
      "problemMatcher": []
    }
  ]
}
